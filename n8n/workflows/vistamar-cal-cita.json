    },
    {
      "parameters": {
        "jsCode": "const CONFIG = {\n  crmApiUrl: 'http://localhost:3001',\n  crmApiKey: 'crm_CAMBIAR'\n};\n\nconst raw = $json.body && typeof $json.body === 'object' ? $json.body : $json;\nconst trigger = String(raw.triggerEvent || raw.trigger || raw.event || '');\nif (trigger && trigger !== 'BOOKING_CREATED' && !/booking[_]?created/i.test(trigger)) {\n  return [];\n}\nconst payload = raw.payload && typeof raw.payload === 'object' ? raw.payload : raw;\nconst responses = payload.responses || {};\nconst phoneValue = responses.phone?.value || responses.smsReminderNumber?.value || payload.smsReminderNumber || '';\nconst emailValue = responses.email?.value || payload.attendees?.[0]?.email || '';\nconst nameValue = responses.name?.value || payload.attendees?.[0]?.name || '';\nconst query = String(phoneValue || emailValue || '').trim();\nif (!query) {\n  return [{ json: { config: CONFIG, foundQuery: false } }];\n}\nreturn [{\n  json: {\n    config: CONFIG,\n    foundQuery: true,\n    query,\n    phone: String(phoneValue || ''),\n    email: String(emailValue || ''),\n    name: String(nameValue || ''),\n    startTime: payload.startTime || payload.start || null,\n    title: payload.title || ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 300],
      "id": "bb000002-normalize-booking",
      "name": "Normalize booking"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "if-query",
              "leftValue": "={{ Boolean($json.foundQuery && $json.query) }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [448, 300],
      "id": "bb000003-if-query",
      "name": "If_query"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.config.crmApiUrl }}/api/v1/contacts?q={{ encodeURIComponent($json.query) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.config.crmApiKey }}" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [672, 220],
      "id": "bb000004-get-contacts",
      "name": "GET contacts",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Normalize booking').first().json;\nconst rows = $input.all().map((i) => i.json);\nconst first = rows[0];\nconst contacts = Array.isArray(first) ? first : (Array.isArray(first?.data) ? first.data : rows.filter((r) => r.publicNumber || r.id));\nconst q = String(prev.query || '').toLowerCase();\nconst digits = q.replace(/\\D/g, '');\nconst contact = contacts.find((c) => {\n  const phone = String(c.phone || '').replace(/\\D/g, '');\n  const email = String(c.email || '').toLowerCase();\n  return (digits && phone && phone.endsWith(digits.slice(-10))) || (q && email && email === q);\n}) || contacts[0];\nif (!contact) {\n  return [{ json: { ...prev, found: false } }];\n}\nconst lead = (contact.leads || [])[0];\nreturn [{\n  json: {\n    ...prev,\n    found: Boolean(lead?.publicNumber || lead?.id),\n    contactPublicNumber: contact.publicNumber,\n    leadPublicNumber: lead?.publicNumber || null,\n    contactName: contact.name\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 220],
      "id": "bb000005-pick-lead",
      "name": "Pick lead"
    },
