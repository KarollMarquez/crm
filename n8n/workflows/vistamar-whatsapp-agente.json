    {
      "parameters": {
        "jsCode": "const prev = $('Build OpenAI').first().json;\nconst raw = $json.choices?.[0]?.message?.content || $json.reply || '';\nlet parsed = {};\ntry { parsed = JSON.parse(raw); } catch (e) { parsed = { reply: String(raw || 'Un momento, te confirmo con el equipo.'), action: 'reply' }; }\nconst action = ['slots', 'book', 'handoff', 'reply'].includes(parsed.action) ? parsed.action : 'reply';\nlet slotDate = parsed.slotDate;\nif (!slotDate) {\n  const d = new Date();\n  d.setDate(d.getDate() + 1);\n  slotDate = d.toISOString().slice(0, 10);\n}\nconst start = new Date(`${slotDate}T00:00:00.000Z`);\nconst end = new Date(start);\nend.setDate(end.getDate() + 1);\nreturn [{\n  json: {\n    ...prev,\n    reply: parsed.reply || 'Gracias por escribirnos. ¿En qué te ayudo?',\n    action,\n    stage: parsed.stage || null,\n    bookingStart: parsed.bookingStart || null,\n    attendeeName: parsed.attendeeName || prev.name,\n    attendeeEmail: parsed.attendeeEmail || prev.email,\n    slotDate,\n    slotStart: start.toISOString(),\n    slotEnd: end.toISOString()\n  }\n}];"
