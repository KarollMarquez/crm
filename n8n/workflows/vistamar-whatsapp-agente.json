    {
      "parameters": {
        "jsCode": "function unpack(row) {\n  try {\n    const parsed = JSON.parse(row.message);\n    if (parsed && typeof parsed === 'object' && parsed.text !== undefined) {\n      return { ...row, ...parsed };\n    }\n  } catch (e) {}\n  return { ...row, text: String(row.message || '') };\n}\n\nconst mensajes = items.map((i) => unpack(i.json));\nmensajes.sort((a, b) => new Date(a.timestamp) - new Date(b.timestamp));\nconst ultimo = mensajes[mensajes.length - 1];\nif (!ultimo) {\n  return [{ json: { mensajes: [], diferencia_ms: 0 } }];\n}\nconst diferencia = Date.now() - new Date(ultimo.timestamp).getTime();\nconst first = mensajes[0];\nconst inbound = $('Normalize inbound').first().json;\nreturn [{\n  json: {\n    mensajes,\n    diferencia_ms: diferencia,\n    conversationId: inbound.conversationId || first.numero,\n    contactId: first.contactId || inbound.contactId,\n    contactPublicNumber: first.contactPublicNumber || inbound.contactPublicNumber,\n    leadId: first.leadId || inbound.leadId,\n    leadPublicNumber: first.leadPublicNumber || inbound.leadPublicNumber,\n    chatwootContactId: first.chatwootContactId || inbound.chatwootContactId,\n    phone: first.phone || inbound.phone,\n    name: first.name || inbound.name,\n    email: first.email || inbound.email,\n    stageSlug: first.stageSlug || inbound.stageSlug,\n    config: inbound.config\n  }\n}];"
      },
