    {
      "parameters": {
        "jsCode": "const prev = $('Parse agent').first().json;\nconst slots = $json.slots || $json.data?.slots || {};\nconst lines = [];\nfor (const [day, arr] of Object.entries(slots)) {\n  const times = (Array.isArray(arr) ? arr : []).slice(0, 8).map((s) => {\n    const t = s.time || s;\n    try {\n      return new Date(t).toLocaleTimeString('es', { hour: '2-digit', minute: '2-digit', timeZone: prev.config.timezone });\n    } catch (e) {\n      return String(t);\n    }\n  });\n  if (times.length) lines.push(`${day}: ${times.join(', ')}`);\n}\nconst reply = lines.length\n  ? `Estos horarios tengo libres:\\n${lines.join('\\n')}\\n\\nDime cuál te queda y te agendo.`\n  : (prev.reply || 'Aún no tengo horarios cargados. ¿Qué día te queda mejor y te confirmo?');\nreturn [{ json: { ...prev, reply, calcomSlots: slots } }];"
