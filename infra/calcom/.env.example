# Cal.com self-hosted (Vista Mar). Copy to .env before `up`.
# Do not start this stack until you need it. Images can be pulled with:
#   docker compose -f infra/calcom/docker-compose.yml pull
# Port 3003 avoids Chatwoot on 3000. Postgres 5434 avoids the CRM on 5433.

NEXT_PUBLIC_WEBAPP_URL=http://localhost:3003
NEXTAUTH_URL=http://localhost:3003
NEXTAUTH_SECRET=replace-with-32-plus-char-secret-key
CALENDSO_ENCRYPTION_KEY=replacewith32charencryptionkey1
CALCOM_TELEMETRY_DISABLED=1
NEXT_PUBLIC_LICENSE_CONSENT=agree
LICENSE=agree

POSTGRES_USER=calcom
POSTGRES_PASSWORD=calcom
POSTGRES_DB=calcom
DATABASE_HOST=database

# Used by the app container (host name is the compose service).
DATABASE_URL=postgresql://calcom:calcom@database:5432/calcom
DATABASE_DIRECT_URL=postgresql://calcom:calcom@database:5432/calcom

# Optional: set after first login when creating the API key / event type for n8n.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
